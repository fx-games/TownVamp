%rec: default
#FIELDS: name type rect belongs_to
#
# Zones divide the town into places the vampire is free to be and places he is
# not. A Zone's permitted occupants are the same predicate as a Private Action's
# Witness Whitelist — may this person be here, seeing this? — asked of a place
# rather than an act.
#
#   type       public or private
#   rect       x,y,width,height
#   belongs_to internal names of the Townspeople who live or work here. Anyone
#              else seen inside is trespassing.
#
# The town map itself marks no interiors, so these are authored here rather than
# on the map. When the LDtk map gains zone layers this file should go away.
#
# Rects must not overlap: the map paints them in file order, but a lookup takes
# the first record that contains the tile. Everything unlisted is public, which
# is why the inn's common room, the church nave and the cemetery are absent —
# the vampire is welcome in all three. Only the rooms behind them are not.

name: Elias's farmhouse
type: private
rect: 20,5,8,7
belongs_to: elias

name: The barn
type: private
rect: 9,13,8,7
belongs_to: elias

name: The mill
type: private
rect: 54,8,8,8
belongs_to: martin

name: Greta's back rooms
type: private
rect: 31,6,3,7
belongs_to: greta

name: The forge
type: private
rect: 44,5,9,8
belongs_to: otto

name: Marta's workshop
type: private
rect: 44,26,9,9
belongs_to: marta

name: The priest's study
type: private
rect: 31,32,3,4
belongs_to: aldren
